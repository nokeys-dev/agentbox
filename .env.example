# Only load this environment in the trusted broker, never the agent workspace.
#
# Variable naming: a `*_PATH` variable is the Compose secret's source file on the host (only
# Compose reads it, to build a file-backed secret at /run/secrets/...); the matching `*_FILE`
# variable is the path the daemon itself reads at runtime (inside the container, that is the
# /run/secrets/... mount; outside Compose, point both at the same host path). Set both of a pair
# when not using Compose.
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_PATH=/absolute/path/to/github-app.pem
# Production: sign App JWTs in AWS KMS with the built-in signer (no CLI/SDK needed). A key ARN
# infers the region; an alias needs AWS_REGION. Not allowed together with GITHUB_PRIVATE_KEY_PATH
# in the process environment (compose.kms.yaml drops it for you).
# AGENTGATE_KMS_KEY_ID=arn:aws:kms:REGION:ACCOUNT:key/KEY_ID
# AGENTGATE_KMS_ENDPOINT=https://kms-fips.us-east-1.amazonaws.com/
# Any other KMS/HSM: JSON argv; the program reads the signing input on stdin and writes the raw
# RSASSA-PKCS1-v1_5 SHA-256 signature. Takes precedence over AGENTGATE_KMS_KEY_ID.
# AGENTGATE_SIGN_COMMAND=["/etc/agentgate/sign-with-aws-kms.sh"]
# Compose KMS override (docker compose -f compose.yaml -f compose.kms.yaml up): also set
# AGENTGATE_KMS_KEY_ID above (required by that override) and the AWS credentials/role below.
# compose.yaml's own GITHUB_PRIVATE_KEY_PATH requirement is still evaluated even though the
# override discards it, so keep GITHUB_PRIVATE_KEY_PATH set to any existing placeholder path
# (e.g. /dev/null) when using the KMS override. AWS_REGION/AWS_ROLE_ARN/AWS_WEB_IDENTITY_TOKEN_FILE
# are passed through to agentd unchanged (standard IRSA/assume-role env); leave unset if the
# image authenticates to AWS another way.
# AWS_REGION=us-east-1
# AWS_ROLE_ARN=arn:aws:iam::ACCOUNT:role/agentgate-kms-signer
# AWS_WEB_IDENTITY_TOKEN_FILE=/var/run/secrets/eks.amazonaws.com/serviceaccount/token
# Provider: github (default) or gitlab. The config's "provider" field must match. GitLab uses an
# OAuth application's refresh token (owner-only, rotated in place by the broker, so the file must
# be writable), client id, and client secret file. See docs/providers/gitlab.md.
# AGENTGATE_PROVIDER=gitlab
# AGENTGATE_GITLAB_URL=https://gitlab.com
# AGENTGATE_GITLAB_CLIENT_ID=your-application-id
# AGENTGATE_GITLAB_CLIENT_SECRET_FILE=/absolute/path/to/gitlab-client-secret
# AGENTGATE_GITLAB_REFRESH_TOKEN_FILE=/absolute/path/to/gitlab-refresh-token
# Fleet mode: one broker for many workspaces. Unset AGENTGATE_CLIENT_TOKEN_FILE and set this to
# "assertion"; each workspace then authenticates with its own token bound inside its runtime
# assertion (identity.mode "assertion" required). See docs/identity.md "Fleet mode: one broker, many workspaces".
# AGENTGATE_CLIENT_AUTH=assertion
AGENTGATE_CONFIG=config.local.json
AGENTGATE_STATE_DIR=.agentgate
# Local revocation list for identity.mode "assertion" without a control plane: owner-only JSON
# { "jtis": [...], "runtimeIds": [...] }, re-read on SIGHUP (an invalid file at startup stops the
# broker; an invalid file on reload is logged and the previous list stays enforced). Not allowed
# with AGENTGATE_CONTROL_URL, where revocations come from signed bundles.
# AGENTGATE_REVOCATIONS_FILE=/etc/agentgate/revocations.json
# How often (ms) agentd checks that file for changes; 0 leaves SIGHUP as the only trigger.
# AGENTGATE_REVOCATIONS_POLL_MS=5000
# Repository mirrors for content scanning (repositories[].scan) hold full repository contents.
# Defaults to <AGENTGATE_STATE_DIR>/mirrors; Compose sets /var/lib/agentgate-mirrors on the
# agentd-only broker-mirrors volume so sidecars mounting broker-state never see them.
# AGENTGATE_MIRROR_DIR=/var/lib/agentgate-mirrors
AGENTGATE_HOST=127.0.0.1
AGENTGATE_PORT=7432
AGENTGATE_MAX_BODY_MIB=2048

# Structured JSON logs (one object per line on stdout/stderr): debug, info, warn, or error.
# Secrets (tokens, authorization headers, keys, etc.) are always redacted regardless of level.
AGENTGATE_LOG_LEVEL=info

# After an unclean shutdown, the broker reclaims its state lock automatically once the recorded
# process on the same host has exited. A lock recorded under a different hostname is never
# reclaimed automatically. Set this to 1 only after confirming that other broker has stopped.
# AGENTGATE_FORCE_UNLOCK=1

# Reviewer identity the CLI (npm run approve / npm run deny) sends on the trusted host. Read on
# the CLI side only, never by the broker itself; unset, the CLI falls back to
# local:$(whoami). Must match ^local:[A-Za-z0-9._@+-]{1,200}$: the CLI refuses oidc: identities,
# which the broker accepts only from the approval web UI. A reviewer that matches the push's
# delegating runtime.human (including local:<name> for an email human <name>@domain) is rejected
# as a self-approval.
# AGENTGATE_REVIEWER=local:alice

# Per-client token-bucket rate limit (keyed by remote address). Requests beyond the budget get a
# 429 RATE_LIMITED response with a retry-after header.
AGENTGATE_RATE_CAPACITY=60
AGENTGATE_RATE_REFILL_PER_SECOND=2
# Assertion mode: a second bucket per runtime (jti); defaults to the per-address values.
# AGENTGATE_RUNTIME_RATE_CAPACITY=60
# AGENTGATE_RUNTIME_RATE_REFILL_PER_SECOND=2

# Prometheus metrics on a separate listener from the Git/API traffic (unauthenticated, so it must
# never share a network with the workspace). Compose binds it to agentd's static address on its own
# `monitoring` network (172.30.94.10:9464), never 0.0.0.0, which would also expose it on the
# workspace network; outside Compose, leave AGENTGATE_METRICS_PORT unset to disable it, or set it with
# AGENTGATE_METRICS_HOST left at the 127.0.0.1 default unless a monitoring-only network exists.
# AGENTGATE_METRICS_HOST=127.0.0.1
# AGENTGATE_METRICS_PORT=9464

# Audit log rotation: rotate audit.jsonl once it reaches this size, and keep at most this many
# rotated files (oldest deleted first). Ship rotated files before they age out; deleting them
# loses local evidence.
AGENTGATE_AUDIT_MAX_MIB=64
AGENTGATE_AUDIT_MAX_FILES=20

# The broker cannot distinguish force pushes from ordinary updates itself, so it verifies at
# startup (and hourly thereafter) that GitHub reports deletion, non_fast_forward, and
# pull_request rules on every branch listed in each repository's protectedBranches. It refuses
# to start if any rule is missing.
# WARNING: local/offline demos only. Setting this to 1 lets the broker start without confirming
# GitHub actually enforces those rules on protected branches.
# AGENTGATE_SKIP_RULESET_CHECK=1

# --- compose.enterprise.yaml only (audit forwarding, OIDC approval UI). The core compose.yaml never
# reads these; leave them unset until you layer that file on. ---
# Off-host audit forwarding: ships chained audit records to a SIEM/object-lock sink over HTTPS,
# checkpointing only after each batch is accepted (at-least-once; the sink must dedupe on hash).
AGENTGATE_AUDIT_SINK_URL=https://siem.example/ingest
AGENTGATE_AUDIT_SINK_TOKEN_PATH=/absolute/path/to/agentgate-audit-sink-token
# What the forwarder process reads at runtime (Compose sets /run/secrets/audit_sink_token).
AGENTGATE_AUDIT_SINK_TOKEN_FILE=/absolute/path/to/agentgate-audit-sink-token
# Protected branches for scripts/detect.js D5 (comma-separated bare branch names) when
# --protected-branches is not given. Read by the detection CLI only, never by the broker.
# AGENTGATE_PROTECTED_BRANCHES=main,release
AGENTGATE_AUDIT_FORWARD_INTERVAL_MS=5000
# Where the forwarder keeps its own progress checkpoint. In Compose, AGENTGATE_STATE_DIR
# (broker-state, mounted read-only into the forwarder) and this checkpoint live in separate
# volumes, so a compromised forwarder cannot write approvals.json or the audit files themselves.
# Defaults to <AGENTGATE_STATE_DIR>/audit-forward.json when unset, which keeps a local (non-Compose)
# run - where the broker and forwarder share one state directory - working unchanged. The broker
# (agentd) also reads this same path, read-only, to report agentgate_audit_forward_lag_records;
# Compose mounts the audit-forward-state volume read-only into agentd for that reason.
AGENTGATE_AUDIT_CHECKPOINT_PATH=/var/lib/agentgate-forward/audit-forward.json

# Slack-compatible incoming webhook, posted to once when a new approval request is created (not
# on retries of an already-pending request). Must be https. The URL is a bearer credential (Slack
# accepts any POST to it), so prefer the *_FILE form, owner-only like other secret files; when
# set, it takes precedence over the raw AGENTGATE_APPROVAL_WEBHOOK_URL below. Leave both unset to
# disable notifications. The notifier never includes the PR body, and escapes Slack mrkdwn
# metacharacters in agent-controlled fields (titles, branches, identities) so an agent cannot
# forge @channel/@user mentions.
# AGENTGATE_APPROVAL_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX
# AGENTGATE_APPROVAL_WEBHOOK_URL_FILE=/absolute/path/to/agentgate-approval-webhook-url
# Optional link to the approval web UI (or any human-readable location) included in the
# notification text so a reviewer can jump straight to the request.
# AGENTGATE_APPROVAL_PUBLIC_URL=https://approvals.example.com

# Workspace-to-broker bearer token (generate: umask 077; openssl rand -hex 32 > ~/.agentgate-client-token)
AGENTGATE_CLIENT_TOKEN_PATH=/absolute/path/to/agentgate-client-token
AGENTGATE_CLIENT_TOKEN_FILE=/absolute/path/to/agentgate-client-token
# Signed runtime assertion (config identity.mode "assertion"): a host-issued, client-token-bound
# identity for this workspace, written by `node scripts/issue-runtime.js --out FILE ...` on the
# trusted host. The *_PATH is the Compose secret source (unset = /dev/null, static identity); the
# workspace reads AGENTGATE_RUNTIME_ASSERTION_FILE. Never give the workspace the issuer private key.
# After re-issuing, run `agentgate renew` in the workspace so Git sends the new assertion.
# AGENTGATE_RUNTIME_ASSERTION_PATH=/absolute/path/to/agentgate-runtime-assertion
# AGENTGATE_RUNTIME_ASSERTION_FILE=/absolute/path/to/agentgate-runtime-assertion
# WARNING: local demos only. Never set this in a shared or production deployment; it lets the
# daemon start with no workspace bearer token, so any client that can reach the listener acts as
# the runtime identity. Leave unset (or "0") and set AGENTGATE_CLIENT_TOKEN_FILE instead.
# AGENTGATE_ALLOW_UNAUTHENTICATED=1

# TLS on the workspace-to-broker hop. Required whenever AGENTGATE_HOST listens beyond loopback
# (the only override is AGENTGATE_ALLOW_PLAINTEXT=1, local demos only). Generate a development CA
# and broker certificate with: sh scripts/make-dev-cert.sh ~/.agentgate-tls
AGENTGATE_TLS_CERT_PATH=/absolute/path/to/agentgate-tls/broker.crt
AGENTGATE_TLS_KEY_PATH=/absolute/path/to/agentgate-tls/broker.key
AGENTGATE_TLS_CERT_FILE=/absolute/path/to/agentgate-tls/broker.crt
AGENTGATE_TLS_KEY_FILE=/absolute/path/to/agentgate-tls/broker.key
# Trust that CA in the workspace, and point AGENTGATE_URL at the broker's HTTPS origin.
AGENTGATE_CA_PATH=/absolute/path/to/agentgate-tls/ca.crt
AGENTGATE_CA_FILE=/absolute/path/to/agentgate-tls/ca.crt
# Broker origin as workspaces reach it (bare http(s) origin, no path or credentials). Used in the
# Git LFS transfer URLs the broker hands out; defaults to the listener address.
# Required when AGENTGATE_HOST is not loopback.
# AGENTGATE_PUBLIC_URL=https://agentd:7432
# Git LFS storage hosts the broker trusts in GitHub batch responses (comma-separated lowercase
# hostnames, no ports or wildcards). Default: github-cloud.githubusercontent.com (observed for
# downloads). Upload hosts are unverified; uploads fail with LFS_UNTRUSTED_HOST until one is added.
# AGENTGATE_LFS_HOSTS=github-cloud.githubusercontent.com
# Largest Git LFS object the transfer proxy accepts, in MiB (1-5120, default 5120 = 5 GiB).
# AGENTGATE_LFS_MAX_OBJECT_MIB=5120
# Concurrent Git LFS object transfers (GET/PUT /lfs-transfer/...), a pool separate from the main
# request pool (1-64, default 8, matching git-lfs's default lfs.concurrenttransfers). A full pool
# returns 503 LFS_BUSY with retry-after. Empty values in these settings mean the default.
# AGENTGATE_LFS_MAX_TRANSFERS=8
# Concurrent Git, API, and LFS batch requests (1-64, default 4). A full pool returns 503 BUSY.
# AGENTGATE_MAX_CONCURRENT=4

# Approval web UI (src/approval-web.js, `npm run approval-web`), served only behind oauth2-proxy.
# See docs/policy.md "Approval web UI". The proxy secret file holds >= 32 random characters shared with
# oauth2-proxy. Create it WITHOUT a trailing newline (`openssl rand -hex 32 | tr -d '\n' > file`):
# oauth2-proxy sends the file byte-for-byte and approval-web refuses to start on whitespace. Host paths are for Compose secrets, *_FILE for the process.
AGENTGATE_APPROVAL_PROXY_SECRET_PATH=/absolute/path/to/approval-proxy-secret
AGENTGATE_APPROVAL_PROXY_SECRET_FILE=/absolute/path/to/approval-proxy-secret
# Shared secret that authenticates approval-web's reviews on the broker admin socket: agentd
# accepts oidc: reviewers only on requests HMAC-signed with it (and rejects all oidc: reviewers
# when AGENTGATE_APPROVAL_WEB_ADMIN_SECRET_FILE is unset). Give it to agentd and approval-web only.
# Owner-only (chmod 600), >= 32 characters, no whitespace or trailing newline:
# `umask 077; openssl rand -hex 32 | tr -d '\n' > file`. Anyone holding it (including a
# compromised approval-web) can approve as any oidc: reviewer.
AGENTGATE_APPROVAL_WEB_ADMIN_SECRET_PATH=/absolute/path/to/approval-web-admin-secret
AGENTGATE_APPROVAL_WEB_ADMIN_SECRET_FILE=/absolute/path/to/approval-web-admin-secret
# Exact browser origin of the proxied UI; POSTs with any other Origin are rejected.
AGENTGATE_APPROVAL_ORIGIN=https://approvals.example.com
# Optional comma-separated allowlist of reviewer email domains (empty = any verified email).
AGENTGATE_APPROVAL_EMAIL_DOMAINS=example.com
# Listener for the UI process. Keep loopback outside Compose; Compose sets 0.0.0.0 on the approval network.
AGENTGATE_APPROVAL_HOST=127.0.0.1
AGENTGATE_APPROVAL_PORT=7433
# Host interface Compose publishes oauth2-proxy's port 4180 on.
AGENTGATE_APPROVAL_PUBLISH_ADDR=127.0.0.1
# Optional overrides for the oauth2-proxy config files mounted by Compose.
# AGENTGATE_OAUTH2_PROXY_ALPHA_CONFIG=./examples/oauth2-proxy.alpha.yaml
# AGENTGATE_OAUTH2_PROXY_CONFIG=./examples/oauth2-proxy.cfg
# Runtime identity issuer (src/issuer-web.js, `npm run issuer-web`), served behind the same
# oauth2-proxy at /issuer/. Developers sign in and mint assertions for their own workspaces; the
# human claim is always their login email. Ed25519 private key (openssl genpkey -algorithm ed25519),
# owner-only; only its public key goes into the broker's identity.issuers with the same kid.
# Hosted agents (src/hosted-agents.js, Compose service hosted-agents): governs vendor-hosted
# agents' pull requests through the AgentBox App's webhooks and a required check run. See
# docs/hosted-agents.md. The webhook secret is what you set on the App's webhook; owner-only.
AGENTGATE_HOSTED_WEBHOOK_SECRET_PATH=/absolute/path/to/hosted-webhook-secret
# AGENTGATE_HOSTED_PUBLISH_ADDR=127.0.0.1
# AGENTGATE_HOSTED_POLL_MS=10000
AGENTGATE_ISSUER_KEY_PATH=/absolute/path/to/issuer.pem
AGENTGATE_ISSUER_KID=k1
AGENTGATE_ISSUER_AUDIENCE=agentgate:acme
# Comma-separated emails that see and may revoke every runtime (platform/security team).
# AGENTGATE_ISSUER_ADMINS=sec@example.com
# Longest assertion a developer may mint, seconds (60-86400).
# AGENTGATE_ISSUER_MAX_TTL=86400
# Directory export (entitlements.static format) restricting delegable teams; container path.
# AGENTGATE_ISSUER_DIRECTORY_FILE=/etc/agentgate/directory.json
# Or live sources (JSON with static/okta/entra in the broker's entitlements shape; container path).
# AGENTGATE_ISSUER_ENTITLEMENTS_FILE=/etc/agentgate/issuer-entitlements.json
OAUTH2_PROXY_CLIENT_SECRET_PATH=/absolute/path/to/oidc-client-secret
# Exactly 32 characters (oauth2-proxy uses the file's bytes as an AES-256 key, and accepts only 16, 24,
# or 32 bytes), no trailing newline: `openssl rand -hex 16 | tr -d '\n' > file` writes 16 random
# bytes hex-encoded as 32 characters. A trailing newline makes it 33 bytes and oauth2-proxy refuses to start.
OAUTH2_PROXY_COOKIE_SECRET_PATH=/absolute/path/to/oauth2-proxy-cookie-secret

# Workspace: the Git host the broker fronts, for URL rewriting and `agentgate pr` remote detection
# (github.com by default; a GitLab instance otherwise).
# AGENTGATE_PROVIDER_HOST=gitlab.example.com
# Compose passes only these non-secret settings into the workspace.
AGENTGATE_GIT_NAME=Your Name
AGENTGATE_GIT_EMAIL=you@example.com
WORKSPACE_MEMORY_LIMIT=4g

# Host path of the egress proxy allowlist mounted into the `egress-proxy` service (see README
# "Workspace egress proxy"). Inside that container the proxy reads AGENTGATE_EGRESS_CONFIG
# (default /etc/agentgate/egress.json), listens on AGENTGATE_EGRESS_HOST (default 0.0.0.0) and
# AGENTGATE_EGRESS_PORT (default 3128); compose.yaml sets those, so they need no .env entry.
# AGENTGATE_EGRESS_CONFIG_PATH=./examples/egress.json
# When attaching Cursor/VS Code/Windsurf with Dev Containers, use the allowlist that also admits
# the IDE server and marketplace hosts (docs/workspace.md "Using an IDE with the workspace"):
# AGENTGATE_EGRESS_CONFIG_PATH=./examples/egress.ide.json

# Prebuilt workspace image to run with the compose.workspace-image.yaml override (a profile such
# as examples/workspace-claude-code.Dockerfile, or a signed ghcr.io digest). See README
# "Workspace profiles".
# AGENTGATE_WORKSPACE_IMAGE=agentgate-workspace-claude:local

# Model API gateway (see docs/workspace.md "Model API gateway"). ANTHROPIC_API_KEY_PATH is the host path of
# the real provider key (chmod 600), mounted only into the `model-gateway` service; the workspace
# never sees it. AGENTGATE_MODEL_GATEWAY_CONFIG_PATH overrides the routes/budget file. Inside the
# container the gateway reads AGENTGATE_MODEL_GATEWAY_CONFIG (default
# /etc/agentgate/model-gateway.json), AGENTGATE_MODEL_GATEWAY_HOST (default 0.0.0.0),
# AGENTGATE_MODEL_GATEWAY_PORT (default 7434) and AGENTGATE_MODEL_GATEWAY_CLIENT_TOKEN_FILE; compose sets
# those. The gateway has its own client token (never the agentd workspace token, so a compromised
# gateway cannot call agentd); the workspace receives it as ANTHROPIC_AUTH_TOKEN via
# AGENTGATE_MODEL_GATEWAY_TOKEN_FILE. Generate it like the workspace token (openssl rand -hex 32, chmod 600).
AGENTGATE_MODEL_GATEWAY_CLIENT_TOKEN_PATH=/absolute/path/to/model-gateway-client-token
ANTHROPIC_API_KEY_PATH=/absolute/path/to/anthropic-api-key
# AGENTGATE_MODEL_GATEWAY_CONFIG_PATH=./examples/model-gateway.json

# Test-only: consumed by `npm run test:live` (scripts/live-smoke.js) from .env.live, never by the
# broker itself. Point these at a disposable GitHub App installation and repository — the script
# pushes, opens, and closes real branches/PRs there. See docs/github.md "Testing against GitHub".
# LIVE_GITHUB_APP_ID=123456
# LIVE_GITHUB_PRIVATE_KEY_PATH=/absolute/path/to/live-github-app.pem
# LIVE_REPO=owner/disposable-repo
# LIVE_REPO_ID=123456789
# LIVE_INSTALLATION_ID=987654321

# Control-plane policy bundles. When AGENTGATE_CONTROL_URL is set, the broker ignores
# AGENTGATE_CONFIG and SIGHUP: it pulls an Ed25519-signed policy bundle and revocation list from
# GET <url>/v1/brokers/<broker id>/policy and /revocations (bearer token, no redirects, 15 s
# timeout, 1 MiB cap), refuses to start until a valid bundle (or a persisted, re-verified one) is
# available, and answers 503 POLICY_EXPIRED once the policy's expiresAt passes without a newer
# version. Accepted versions are persisted in $AGENTGATE_STATE_DIR/bundle-state.json (rollback
# protection; a corrupt file stops the broker rather than resetting). Both files must be chmod 600.
# Policy expiry is enforced per request. With identity.mode "assertion", a revocation list must also
# be current: the broker refuses to start without one and answers 503 REVOCATIONS_EXPIRED once it
# lapses, so the control plane must re-publish revocations (even an empty list) regularly.
# AGENTGATE_CONTROL_URL=https://control.example
# Compose override secrets for control mode (see docs/control-plane.md "Control plane"): host files for the two
# *_FILE values above.
# AGENTGATE_CONTROL_TOKEN_PATH=/absolute/path/to/agentgate-control-token
# AGENTGATE_CONTROL_KEYS_PATH=/absolute/path/to/control-keys.json
# AGENTGATE_BROKER_ID=broker-a
# AGENTGATE_CONTROL_TOKEN_FILE=/run/secrets/agentgate-control-token
# JSON { "kid": "-----BEGIN PUBLIC KEY-----\n..." } of Ed25519 public keys; other key types are rejected.
# AGENTGATE_CONTROL_KEYS_FILE=/etc/agentgate/control-keys.json
# AGENTGATE_CONTROL_POLL_MS=60000
# Local development/tests only: permit an http:// control URL.
# AGENTGATE_CONTROL_ALLOW_HTTP=1
# The broker also POSTs a heartbeat to <url>/v1/brokers/<broker id>/heartbeat every 60 s with the
# same token: { version, policyVersion, auditHead: { seq, hash }, uptimeSeconds }. A 409
# AUDIT_ROLLBACK is logged as control.audit_rollback_reported (error); the broker keeps running.

# Minimal control plane (node src/control-plane.js; see examples/control-plane.compose.yaml).
# It stores signed documents but never holds signing keys. Production requires TLS.
# Central approvals (control plane): the Ed25519 key that signs reviews documents (its public
# key goes into every broker's AGENTGATE_CONTROL_KEYS_FILE under the same kid) and the reviewer
# UI behind oauth2-proxy (proxy secret shared with it, no trailing newline).
# AGENTGATE_CONTROL_REVIEW_KEY_FILE=/run/secrets/control_review_key
# AGENTGATE_CONTROL_REVIEW_KID=reviews1
# AGENTGATE_CONTROL_PROXY_SECRET_FILE=/run/secrets/control_proxy_secret
# AGENTGATE_CONTROL_EMAIL_DOMAINS=example.com
# AGENTGATE_CONTROL_ORIGIN=https://approvals.example.com
# AGENTGATE_CONTROL_DATA_DIR=/var/lib/agentgate-control
# AGENTGATE_CONTROL_HOST=127.0.0.1
# AGENTGATE_CONTROL_PORT=7440
# JSON { "broker-a": "<sha256 hex of broker-a's token>" }
# AGENTGATE_CONTROL_BROKER_TOKENS_FILE=/run/secrets/broker_tokens
# File containing the sha256 hex of the admin token (used for PUT /v1/admin/* and inventory).
# AGENTGATE_CONTROL_ADMIN_TOKEN_SHA256_FILE=/run/secrets/admin_token_sha256
# Optional: when set, uploaded documents must verify against these Ed25519 public keys.
# AGENTGATE_CONTROL_KEYS_FILE=/etc/agentgate/control-keys.json
# TLS listener (required beyond loopback unless AGENTGATE_CONTROL_ALLOW_PLAINTEXT=1 behind a
# TLS-terminating proxy).
# AGENTGATE_CONTROL_TLS_CERT_FILE=/run/secrets/control_tls_cert
# AGENTGATE_CONTROL_TLS_KEY_FILE=/run/secrets/control_tls_key
# AGENTGATE_CONTROL_ALLOW_PLAINTEXT=1
# Host paths for examples/control-plane.compose.yaml secrets.
# AGENTGATE_CONTROL_BROKER_TOKENS_PATH=/absolute/path/to/broker-tokens.json
# AGENTGATE_CONTROL_ADMIN_TOKEN_SHA256_PATH=/absolute/path/to/admin-token.sha256
# AGENTGATE_CONTROL_TLS_CERT_PATH=/absolute/path/to/control.crt
# AGENTGATE_CONTROL_TLS_KEY_PATH=/absolute/path/to/control.key
# AGENTGATE_CONTROL_BIND=127.0.0.1

# npm run test:docker: the agentd image to check for git (default agentgate:local).
# AGENTGATE_IMAGE=agentgate:local
